# Copy this file to .env and replace every placeholder value.
# .env is git ignored. Only this example file is committed.
# Passwords below are placeholders for local development only.

# ---- Compose and host ports (change if a port is already in use) ----
COMPOSE_PROJECT_NAME=governed-analytics
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8010
WEB_HOST_PORT=5180
DAGSTER_HOST_PORT=3010

# ---- PostgreSQL instance ----
# Superuser is used only for bootstrap (schemas, roles, extensions).
POSTGRES_DB=copilot
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Database roles created by infra/postgres/init (least privilege, see docs/architecture.md)
# loader: writes raw and builds analytics (dbt and load scripts)
LOADER_DB_PASSWORD=change-me-loader
# warehouse_ro: read only on analytics, used by the query executor (Phase 5)
WAREHOUSE_RO_DB_PASSWORD=change-me-warehouse-ro
# app_rw: owns the app schema (users, policies, audit, caches)
APP_RW_DB_PASSWORD=change-me-app-rw

# ---- Application ----
APP_ENV=local
LOG_LEVEL=INFO
# Connection used by the API for application tables and readiness checks (inside compose network)
APP_DATABASE_URL=postgresql://app_rw:change-me-app-rw@postgres:5432/copilot
# Same database reached from the host (used by make index and make retrieval)
APP_DATABASE_URL_HOST=postgresql://app_rw:change-me-app-rw@localhost:5433/copilot
# Used by the data scripts on the host (uv run) when the database is on localhost
LOADER_DATABASE_URL=postgresql://loader:change-me-loader@localhost:5433/copilot
# Read only executor role. Used by the semantic golden tests to run gold SQL as the executor would.
WAREHOUSE_RO_DATABASE_URL=postgresql://warehouse_ro:change-me-warehouse-ro@localhost:5433/copilot

# ---- Authentication (Phase 3) ----
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# ---- LLM providers (Phase 4, free tiers) ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Dataset download (Phase 1, free Kaggle account) ----
KAGGLE_USERNAME=
KAGGLE_KEY=
